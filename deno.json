{
  "version": "0.1.0",
  "lock": false,
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
    "jsx": "precompile",
    "jsxImportSource": "@hono/hono/jsx"
  },
  "imports": {
    "@/": "./src/",
    "@hono/hono": "jsr:@hono/hono@^4.8.0",
    "@hono/hono/": "jsr:@hono/hono@^4.8.0/",
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.5",
    "@std/crypto": "jsr:@std/crypto@^1.0.5",
    "zod": "npm:zod@^3.25.64",
    "jose": "npm:jose@^5.10.0",
    "drizzle-orm": "npm:drizzle-orm@^0.44.2",
    "drizzle-orm/": "npm:drizzle-orm@^0.44.2/",
    "postgres": "npm:postgres@^3.4.7",
    "argon2": "jsr:@denosaurs/argontwo@^0.2.0"
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read src/main.ts",
    "check": "deno check src/main.ts src/tests/**/*.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "deno test --allow-env --allow-read --allow-net=127.0.0.1,localhost",
    "test:coverage": "deno test --coverage=coverage --allow-env --allow-read --allow-net=127.0.0.1,localhost && deno coverage coverage --lcov --output=coverage/lcov.info",
    "db:migrate": "deno run --allow-env --allow-read --allow-net src/database/migrate.ts",
    "db:seed": "deno run --allow-env --allow-read --allow-net src/database/seed.ts",
    "openapi": "deno run --allow-read --allow-write scripts/write_openapi.ts",
    "prepare": "deno run --allow-read --allow-write npm:husky install"
  },
  "fmt": { "lineWidth": 100, "semiColons": true, "singleQuote": false },
  "lint": { "rules": { "tags": ["recommended"] } }
}
