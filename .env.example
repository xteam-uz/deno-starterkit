APP_ENV=development
APP_NAME=deno-starterkit
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deno_starterkit
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_BODY_LIMIT_BYTES=1048576
